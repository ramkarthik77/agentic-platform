# Copy to .env. CLI entry points load this file without overriding exported variables.
AAAEM_MODE=local
AAAEM_INTEGRATION_MODE=fixture
AAAEM_MODEL_PROVIDER=fixture
AAAEM_ALLOWED_HOSTS=127.0.0.1,localhost
# To use live integrations, copy/edit config/workspace.example.json -> config/local.json,
# copy/edit config/registry.example.json -> config/registry.local.json and configure registry_file.
# AAAEM_CONFIG_FILE=config/local.json
# AAAEM_INTEGRATION_MODE=live
# Use a SEPARATE database when switching fixture/live provenance.
# DATABASE_URL=sqlite:///.data/aaaem-live.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/aaaem?sslmode=require
# Hosted mode additionally requires OIDC configuration, PostgreSQL and HTTPS.
# AAAEM_MODE=production
# AAAEM_PUBLIC_ORIGIN=https://agents.your-domain.example
# AAAEM_ALLOWED_HOSTS=agents.your-domain.example,127.0.0.1
# AAAEM_OIDC_CLIENT_SECRET=
# Model: deterministic summaries work without inference. Select one optional provider.
# AAAEM_MODEL_PROVIDER=bedrock
# AAAEM_MODEL_ID=approved-model-or-inference-profile-id
# AWS_REGION=us-east-1
# AWS_PROFILE=your-approved-profile
# AAAEM_MODEL_PROVIDER=openai_compatible
# AAAEM_MODEL_ENDPOINT=https://your-model-gateway.example/v1
# AAAEM_MODEL_API_KEY=
# Integrations: set only those needed for your selected workflows.
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# ADOBE_ORG_ID=
# NEW_RELIC_API_KEY=
# SPLUNK_TOKEN=
# SNYK_TOKEN=
# SONAR_TOKEN=
# AAAEM_GITHUB_TOKEN=
# AEM_BRIDGE_TOKEN=
# AAAEM_VERIFIER_TOKEN=
# AAAEM_VERIFIER_ALLOWED_HOSTS=www.your-site.example,cdn.your-site.example
# AAAEM_INTAKE_SECRET=
# AAAEM_CA_BUNDLE=/absolute/path/to/enterprise-ca.pem
# AAAEM_WORKER_ENABLED=true
# Containers may receive complete JSON documents from Secrets Manager:
# AAAEM_WORKSPACE_JSON=<workspace configuration JSON; supplied by runtime secret injection>
# AAAEM_REGISTRY_JSON=<site registry JSON; supplied by runtime secret injection>
